# =============================================================================
# LusoraeCrime — Variáveis de Ambiente de Produção
# =============================================================================
# Não precisas de preencher isto à mão: `sudo bash deploy/hostinger-setup.sh`
# gera automaticamente um deploy/.env.production com segredos aleatórios na
# primeira execução. Este ficheiro serve de referência/documentação.
#
# Se preferires preencher à mão:
#   cp .env.production.example .env.production
#   nano .env.production
#
# NUNCA comites .env.production no Git — está no .gitignore.
# =============================================================================

APP_ENV=production

# Domínio/hostname do site (sem https://). Por omissão usamos o hostname que
# a Hostinger já dá ao VPS (resolve automaticamente, sem precisares de
# comprar domínio). Podes trocar por um domínio teu mais tarde.
SITE_DOMAIN=srv1758509.hstgr.cloud

# Email para os certificados Let's Encrypt (avisos de expiração).
ACME_EMAIL=tiago.mrj17@gmail.com

# -----------------------------------------------------------------------------
# JWT — Segurança de autenticação
# -----------------------------------------------------------------------------
# Gerar com: openssl rand -hex 64
JWT_SECRET=SUBSTITUI_POR_STRING_ALEATORIA_DE_64_CHARS

# -----------------------------------------------------------------------------
# MongoDB — Base de dados
# -----------------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=lusoraecrime_admin
MONGO_INITDB_ROOT_PASSWORD=SUBSTITUI_POR_PASSWORD_FORTE

# URL de ligação ao MongoDB (usa o hostname "mongo" — nome do serviço Docker)
MONGO_URL=mongodb://lusoraecrime_admin:SUBSTITUI_POR_PASSWORD_FORTE@mongo:27017/?authSource=admin

DB_NAME=lusoraecrime

# Porta exposta em loopback do host (debug local apenas)
BACKEND_PORT=8001

# -----------------------------------------------------------------------------
# Conta de administrador inicial (criada/atualizada em cada arranque)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@lusoraecrime.com
# Mínimo 12 caracteres — o default "admin123" do código NUNCA deve ser usado
# em produção.
ADMIN_PASSWORD=SUBSTITUI_POR_PASSWORD_ADMIN_FORTE

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista de origens permitidas, separadas por vírgula (sem espaços, sem trailing slash)
CORS_ORIGINS=https://srv1758509.hstgr.cloud
